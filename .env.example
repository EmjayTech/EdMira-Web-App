# Backend the web app talks to (same backend as the mobile app).
#   production (default) — https://edmira-backend.onrender.com
#   local                — EdMira-Backend on this computer (yarn dev:memory)
NEXT_PUBLIC_API_TARGET=production
# NEXT_PUBLIC_API_URL=https://edmira-backend.onrender.com
# NEXT_PUBLIC_LOCAL_API_URL=http://localhost:4000

# Public URL of this website (SEO, sitemap, social cards).
NEXT_PUBLIC_SITE_URL=https://edmira.org
